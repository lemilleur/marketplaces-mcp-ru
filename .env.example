# Copy to .env and fill in. Never commit real keys.

# --- Wildberries (one token, scoped per category at seller.wildberries.ru) ---
WB_API_TOKEN=

# --- Ozon (Seller account -> Settings -> API keys) ---
OZON_CLIENT_ID=
OZON_API_KEY=

# Optional Ozon advertising credentials (separate from Seller API)
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=

# Optional Telegram report delivery. Real values belong in Easypanel, never Git.
TELEGRAM_BOT_TOKEN=
# Alias-to-chat-ID allowlist, e.g. me:123456789,team:-1001234567890
TELEGRAM_CHATS=
